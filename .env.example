# MIA 4.1 server configuration (copy to your process manager / shell; never commit real values)
MIA_PORT=8787
MIA_HOST=127.0.0.1            # keep loopback unless you put MIA behind TLS + reverse proxy
MIA_DATA_DIR=./data           # SQLite database + QA evidence
MIA_DEEP_TIER=24              # instruments analyzed with candles + order books
MIA_SCAN_INTERVAL_MS=60000
MIA_TICKER_INTERVAL_MS=15000
# Engine lease TTL override in ms for OFFLINE tests only; ignored when market polling is on (default: 3 ticker intervals, min 45 s)
MIA_ENGINE_LEASE_TTL_MS=
# Optional — Trader Joe conversational mode (otherwise deterministic command mode)
ANTHROPIC_API_KEY=
MIA_JOE_MODEL=claude-opus-5-5
# Optional — Telegram notifications (api.telegram.org must be reachable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional — evidence-packet HMAC key (64+ hex chars = 32+ bytes). If unset, MIA creates data/evidence.key (mode 0600)
# atomically and reuses it. Keep a protected copy separate from the snapshot. Invalid or unavailable durable keys stop startup.
MIA_EVIDENCE_KEY=
# Required for online and production backup creation, including the first Privy owner binding.
# Set a 32-byte encryption key as 64 hex characters or base64 in the process manager or secret store.
MIA_BACKUP_KEY=
# Order books older than this are never used to size or fill a paper trade (default 60000 ms)
MIA_MAX_EXEC_BOOK_AGE_MS=60000
# Set to 1 when MIA is served over HTTPS (adds Secure to the session cookie)
MIA_SECURE_COOKIE=
# First-time owner setup is accepted only from this machine or a detected container; set 1 to allow any client
MIA_ALLOW_REMOTE_SETUP=

# Quant Academy (knowledge library)
MIA_KB_MAX_UPLOAD_MB=60        # max document upload size
MIA_KB_EMBEDDINGS=local-hash-v1 # only provider implemented; lexical vectors (not semantic)

# PRIVY WALLET LOGIN — active by default when MIA_OFFLINE is not 1
# Configure dashboard.privy.io with WALLET login method and the exact HTTPS origin.
# App ID is public; never put private keys or Privy App Secret into a frontend VITE_* variable.
MIA_AUTH_MODE=privy
MIA_PRIVY_APP_ID=
# Preprovision the OWNER's verified Privy DID (did:privy:...), never let the first visitor self-enroll.
MIA_PRIVY_OWNER_ID=
# Optional public ES256 PEM verification key; otherwise backend fetches the public JWKS.
MIA_PRIVY_VERIFICATION_KEY=
# Embedded wallet auto-creation and all sign/send/fund/export operations remain disabled.
MIA_PRIVY_EMBEDDED_WALLETS=0

# OFFLINE TEST/RECOVERY ONLY: set BOTH MIA_OFFLINE=1 and MIA_AUTH_MODE=passphrase.
# This is NOT a remote production fallback. Return to Privy after controlled recovery.

# DITAS outcome-based no-trade guard: SHADOW (default) or PAPER_ENFORCE.
# PAPER_ENFORCE can only refuse entries; enable only after reviewed paper-replay evidence.
MIA_EXPERIENCE_NO_TRADE_MODE=SHADOW
