# MIA 4.1 server configuration (copy to your process manager / shell; never commit real values)
MIA_PORT=8787
# keep loopback unless you put MIA behind TLS + reverse proxy
MIA_HOST=127.0.0.1
# MIA_DATA_DIR=/var/lib/mia    # SQLite database + QA evidence. Use an ABSOLUTE path; unset = <repo>/data. A relative
#                               # path resolves from the server's working directory (server/), splitting the database.
# instruments analyzed with candles + order books
MIA_DEEP_TIER=24
MIA_SCAN_INTERVAL_MS=60000
MIA_TICKER_INTERVAL_MS=15000
# Engine lease TTL override in ms for OFFLINE tests only; ignored when market polling is on (default: 3 ticker intervals, min 45 s)
MIA_ENGINE_LEASE_TTL_MS=
# Optional — Trader Joe conversational mode (otherwise deterministic command mode)
ANTHROPIC_API_KEY=
MIA_JOE_MODEL=claude-opus-5-5
# Optional — Vike Data research (data.vike.io must be reachable). Server-side ONLY: never in the browser, git, logs or chat.
# Use a freshly rotated key (vk_...). Without it, Vike shows PENDING_CREDENTIALS and makes no requests. Research only.
# MIA_VIKE_API_KEY=
# Sign-in (docs/operations/PRIVY_SIGN_IN.md). Privy is the default sign-in; the App ID is public, not a secret.
# Needs HTTPS (or localhost). Wallet signing/sending stays LOCKED.
# MIA_PRIVY_APP_ID=
# MIA_PRIVY_OWNER_ID=did:privy:...   # the owner's Privy user id; bound (after a backup) on that user's first sign-in
# MIA_AUTH_MODE=passphrase           # ONLY for offline development/tests/recovery: restores the old passphrase sign-in
# MIA_PRIVY_VERIFICATION_KEY=   # optional PEM public key from the Privy dashboard (otherwise fetched from auth.privy.io)
# MIA_PRIVY_EMBEDDED_WALLETS=1  # optional: let the owner create a Privy-secured wallet (view-only in MIA; no signing)
# Optional — CCXT exchange research (read-only, keyless, GET-only). 1 = use official exchange test URLs where they exist.
# MIA_CCXT_SANDBOX=1
# Optional — Ethereum JSON-RPC for read-only Aave V3 research (https only; treat a URL containing a key as a secret).
# Default: https://ethereum-rpc.publicnode.com
# MIA_ETH_RPC_URL=
# Optional — Solana JSON-RPC for read-only mint checks on the Solana watchlist (Omega PR-06). https only; a URL that
# contains a provider key is a secret. Unset = no on-chain checks. The public endpoint below is rate-limited (about
# 100 requests per 10 s per IP) and not meant for production; MIA sends about one batched request per DEX refresh.
# MIA_SOLANA_RPC_URL=https://api.mainnet.solana.com
# Optional — read-only Pump.fun launch/graduation feed on the Solana watchlist (Omega PR-07). Keeps one WebSocket open
# to the Solana endpoint above (about 3 kB/s). 1 = on. The WebSocket URL is the RPC host over wss unless set below.
# MIA_PUMPFUN_FEED=1
# MIA_SOLANA_WS_URL=
# Optional — Python research labs (scripts/research-python.sh). Python version for the isolated venvs, and a CA file
# only needed behind a forced HTTPS proxy.
# MIA_RESEARCH_PYTHON=3.13
# MIA_RESEARCH_CA_FILE=
# Optional — SEC EDGAR research. Use your application or organization name and a real contact email.
MIA_SEC_USER_AGENT=
# Optional — Telegram notifications (api.telegram.org must be reachable)
TELEGRAM_BOT_TOKEN=
# Set the same secret in Telegram setWebhook for /api/integrations/telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
# Optional — evidence-packet HMAC key (64+ hex chars = 32+ bytes). If unset, MIA creates data/evidence.key (mode 0600)
# once and reuses it; back that file up with the database. A malformed value stops startup instead of being ignored.
MIA_EVIDENCE_KEY=
# Order books older than this are never used to size or fill a paper trade (default 60000 ms)
MIA_MAX_EXEC_BOOK_AGE_MS=60000
# Set to 1 when MIA is served over HTTPS (adds Secure to the session cookie)
MIA_SECURE_COOKIE=
# First-time owner setup requires the one-time code printed in the MIA server console.

# Quant Academy (knowledge library)
# max document upload size
MIA_KB_MAX_UPLOAD_MB=60
# only provider implemented; lexical vectors (not semantic)
MIA_KB_EMBEDDINGS=local-hash-v1

# --- Backups (see docs/operations/DEPLOYMENT_GUIDE.md) ---
# Encryption key: 32 random bytes (openssl rand -hex 32). Without it backups are PLAINTEXT. Keep it outside the backups.
# MIA_BACKUP_KEY=
# MIA_BACKUP_DIR=/var/lib/mia/backups
# Hours between scheduled backups (0 disables)
# MIA_BACKUP_INTERVAL_H=24
# MIA_BACKUP_KEEP=14

# --- Optional features ---
# Streaming order books (Binance WebSocket; REST stays the fallback). Needs outbound wss://data-stream.binance.vision
# MIA_STREAMING=1
# Log level (fatal, error, warn, info, debug)
# MIA_LOG=info
# Built web UI directory (default: web/dist)
# MIA_WEB_DIST=

# --- Supervisor (npm run start:supervised) ---
# MIA_SUPERVISE_MAX_CRASHES=8
# MIA_SUPERVISE_WINDOW_MS=600000
# MIA_SUPERVISE_STABLE_MS=120000

# Optional Google owner sign-in. Requires MIA_SECURE_COOKIE=1 and an HTTPS web OAuth client.
MIA_GOOGLE_CLIENT_ID=
MIA_GOOGLE_CLIENT_SECRET=
MIA_GOOGLE_REDIRECT_URI=
