{
  "name": "@mia/server",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/index.ts",
    "start": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "qa": "mkdir -p ../data/qa && NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run --reporter=default --reporter=json --outputFile.json=../data/qa/test-results.json",
    "test:live": "NODE_USE_ENV_PROXY=1 MIA_LIVE_TESTS=1 vitest run test/live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/static": "^8.3.0",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
