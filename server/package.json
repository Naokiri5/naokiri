{
  "name": "@mia/server",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs start",
    "start:supervised": "node scripts/supervise.mjs",
    "backup": "node scripts/run.mjs backup",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "qa": "node scripts/qa.mjs",
    "test:live": "cross-env NODE_USE_ENV_PROXY=1 MIA_LIVE_TESTS=1 NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run test/live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/static": "^10.1.11",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "jose": "^4.15.9",
    "pdfjs-dist": "^6.5.438",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  }
}
